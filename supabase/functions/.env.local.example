# Local secrets for `supabase functions serve`.
# Copy to supabase/functions/.env.local (which is gitignored) and fill in.
#
# NONE of these belong in the frontend. They are read by Deno inside the
# function, which runs on Supabase's servers.

# Injected automatically for deployed functions; needed only for local serving.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that lets a machine (pg_cron, GitHub Actions) call sync-aredl
# without a user session. Generate one with:  openssl rand -hex 32
SYNC_SECRET=

# Optional. Comma-separated list of origins allowed to call the functions.
# Leave blank to reflect the caller's origin - every function still requires a
# valid Supabase JWT or the sync secret, so this is defence in depth, not the
# lock itself.
# ALLOWED_ORIGINS=https://yourname.github.io,http://localhost:5173

# Optional provider overrides, matching the frontend's VITE_ equivalents.
# AREDL_API_BASE=https://api.aredl.net/v2
# GD_API_BASE=https://gdbrowser.com
