# ---------------------------------------------------------------------------
# BLGD - environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# ONLY public/publishable values belong here. Everything in a VITE_* variable
# is compiled into the JavaScript bundle and is therefore world-readable.
# The service_role key must NEVER be placed in this file.
# ---------------------------------------------------------------------------

# Required. Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Required. The "anon"/publishable key. Safe to ship: Row Level Security is what
# actually protects the data.
VITE_SUPABASE_ANON_KEY=

# Optional. Base path the app is served from. Leave blank for local dev.
# For GitHub Pages at https://<user>.github.io/<repo>/ set this to "/<repo>/".
# The GitHub Actions workflow sets it automatically, so you normally do not
# need to touch it.
VITE_BASE_PATH=

# Optional. Public site name shown in the UI.
VITE_SITE_NAME=BLGD

# Optional overrides for the external data providers. Defaults are shown.
# Change these if you self-host a mirror or the upstream service moves.
VITE_AREDL_API_BASE=https://api.aredl.net/v2
VITE_GD_API_BASE=https://gdbrowser.com

# Optional. "auto" (default) tries Supabase Edge Functions first and falls back
# to calling the public APIs straight from the browser. Use "edge" to require
# the Edge Functions, or "direct" to skip them entirely.
VITE_DATA_MODE=auto
